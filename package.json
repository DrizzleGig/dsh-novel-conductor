{
  "name": "dsh-novel-conductor",
  "version": "0.1.1",
  "description": "舞台监督：为长篇小说写作排一条可回查的 runbook。它不写正文、不改兄弟账本，只负责这一章先做什么、后做什么，并用宿主工具收据验证每一步真的发生了。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check lib/tools.js && node --check lib/run-machine.js && node --check lib/run-store.js && node --check lib/receipt.js && node --check lib/adapters/beat.js && node --check lib/adapters/fade.js && node --check lib/adapters/voice.js && node --check lib/adapters/common.js && node --check lib/session.js && node --check lib/receipt-bus.js",
    "acceptance": "node scripts/simulate-acceptance.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "novel",
    "novel-writing",
    "long-form",
    "runbook",
    "conductor",
    "orchestration"
  ],
  "license": "MIT",
  "author": "DrizzleGig",
  "contributors": [
    {
      "name": "MiyueWinter",
      "email": "mingyue_11129@qq.com",
      "url": "https://github.com/MiyueWinter"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrizzleGig/dsh-novel-conductor.git"
  },
  "homepage": "https://github.com/DrizzleGig/dsh-novel-conductor",
  "bugs": {
    "url": "https://github.com/DrizzleGig/dsh-novel-conductor/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
